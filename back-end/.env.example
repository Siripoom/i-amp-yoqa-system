JWT_SECRET=your_jwt_secret_key
MONGO_URI=myour_mongodb_url
PORT=5001

# LINE Login channel used to verify LIFF ID tokens server-side.
LINE_LOGIN_CHANNEL_ID=
# LINE Messaging API channel access token (server-side only; never expose to LIFF)
LINE_CHANNEL_ACCESS_TOKEN=

# Backblaze B2 public bucket (server-side only)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Optional CDN/download URL, including the bucket path when required.
# Defaults to B2_ENDPOINT/B2_BUCKET_NAME. Do not include a trailing slash.
B2_PUBLIC_BASE_URL=
